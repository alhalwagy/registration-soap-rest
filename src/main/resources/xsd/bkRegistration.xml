                <xs:element name="loginUsername" type="xs:string" minOccurs="0"/>
                <xs:element name="activationCode" type="xs:string" minOccurs="0"/>
                <xs:element name="pmtAttemptFlag" type="xs:string" minOccurs="0"/>
                <xs:element name="activationDate" type="xs:dateTime" minOccurs="0"/>
                <xs:element name="registrationEmail" type="xs:string" minOccurs="0"/>
                <xs:element name="registrationMobile" type="xs:string" minOccurs="0"/>
                <xs:element name="dashboardViewingTypeId" type="xs:long" minOccurs="0"/>
                <xs:element name="customerIp" type="xs:string" minOccurs="0"/>
                <xs:element name="cspChannelId" type="xs:string" minOccurs="0"/>
                <xs:element name="kycLevelId" type="xs:long" minOccurs="0"/>
                <xs:element name="jobTitle" type="xs:string" minOccurs="0"/>
                <xs:element name="monthlySalary" type="xs:double" minOccurs="0"/>
                <xs:element name="memo" type="xs:string" minOccurs="0"/>
                <xs:element name="hasBankAccount" type="xs:string" minOccurs="0"/>
                <xs:element name="companyName" type="xs:string" minOccurs="0"/>
                <xs:element name="isSelfReg" type="xs:string" minOccurs="0"/>
                <xs:element name="regVerMethod" type="xs:string" minOccurs="0"/>
                <xs:element name="customerValidationStatus" type="xs:long" minOccurs="0"/>
                <xs:element name="extTransferEnabled" type="xs:boolean" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="UpdateRegistrationResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="BKRegistrationResReadUpdate" type="tns:BKRegistrationResReadUpdate"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


</xs:schema>
