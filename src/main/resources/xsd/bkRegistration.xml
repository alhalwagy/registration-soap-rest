                <xs:element name="defaultSof" type="xs:string" minOccurs="0"/>
                <xs:element name="deactivationDate" type="xs:dateTime" minOccurs="0"/>
                <xs:element name="deactivationReason" type="xs:string" minOccurs="0"/>
                <xs:element name="registrationDate" type="xs:dateTime" minOccurs="0"/>
                <xs:element name="creationDate" type="xs:dateTime" minOccurs="0"/>
