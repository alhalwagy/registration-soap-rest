<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://fawry.com/crud/bkregistration"
           targetNamespace="http://fawry.com/crud/bkregistration"
           elementFormDefault="qualified">

    <!--    &lt;!&ndash; Request Element &ndash;&gt;-->
    <xs:element name="GetRegistrationByIdRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Response Elements -->
    <xs:complexType name="CustomerResRead">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="customerType" type="xs:string"/>
            <xs:element name="nationality" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BKRegistrationResRead">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="statusId" type="xs:long"/>
            <xs:element name="customer" type="tns:CustomerResRead"/>
            <xs:element name="senderId" type="xs:long"/>
            <xs:element name="registrationEmail" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BKRegistrationResReadUpdate">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="statusId" type="xs:long"/>
            <xs:element name="customer" type="tns:CustomerResRead"/>
            <xs:element name="senderId" type="xs:long"/>
            <xs:element name="registrationEmail" type="xs:string"/>
            <xs:element name="companyName" type="xs:string"/>
            <xs:element name="jobTitle" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="GetRegistrationByIdResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="BKRegistrationResRead" type="tns:BKRegistrationResRead"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetRegistrationsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="BKRegistrationResRead" type="tns:BKRegistrationResRead" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetRegistrationsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="page" type="xs:int"/>
                <xs:element name="size" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteByIdRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteByIdResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <xs:element name="CreateBKRegistrationRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="customerId" type="xs:long" minOccurs="0"/>
                <xs:element name="statusId" type="xs:long" minOccurs="0"/>
                <xs:element name="sender_id" type="xs:long" minOccurs="0"/>
